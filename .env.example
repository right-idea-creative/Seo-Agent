# SEO-Agent — Variables de entorno
# Copia este archivo: cp .env.example .env
# Luego rellena los valores reales.

# ══ REQUERIDO ══════════════════════════════════════════════════
ANTHROPIC_API_KEY=tu_api_key_aqui

# ══ CLAUDE (opcional) ══════════════════════════════════════════
# CLAUDE_MODEL=claude-opus-4-8

# ══ ARTÍCULO (opcional) ════════════════════════════════════════
# DEFAULT_LANGUAGE=es
# DEFAULT_TONE=profesional
# DEFAULT_WORD_COUNT=1000

# ══ SALIDA (opcional) ══════════════════════════════════════════
# OUTPUT_DIR=output/articles

# ══ CLI — Tenant por defecto (opcional) ════════════════════════
# Evita escribir --client-id y --website-id en cada comando.
# DEFAULT_CLIENT_ID=mi-agencia
# DEFAULT_WEBSITE_ID=sitio-principal

# ══ V2 — WordPress ════════════════════════════════════════════
# Las credenciales de WordPress van en archivos JSON por cliente y sitio:
#   credentials/{client_id}/{website_id}.json
# Ver credentials/README.md para el formato y las instrucciones de configuración.
# CREDENTIALS_DIR=credentials   # Ruta alternativa si no usas la carpeta por defecto

# ══ V2 — Google Drive (no implementado aún) ════════════════════
# GOOGLE_SA_JSON_PATH=credentials/service_account.json
# DRIVE_FOLDER_ID=tu_folder_id_de_drive

# ══ V3 — Ahrefs (no implementado aún) ═════════════════════════
# AHREFS_API_KEY=tu_api_key_de_ahrefs
